<% if (theme.mathjax){ %>
<!-- MathJax 3 (local, no CDN) config similar to math.stackexchange -->
<script>
window.MathJax = {
    tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
    },
    svg: {
        fontCache: 'global'
    },
    options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
    }
};
</script>
<script defer src="<%- url_for('/vendor/mathjax/tex-svg.js') %>"></script>
<% } %>